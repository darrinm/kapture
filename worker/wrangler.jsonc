{
  // Deploying your own? Change "routes" to your domain, "kv_namespaces[0].id" to the id
  // `wrangler kv namespace create QUOTAS` prints for your account, and ADMIN_OWNER to your own
  // owner name. The values below are the author's deployment; none of them is a secret, but
  // none of them will work in your account either.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kapture-share",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "kapture.sh", "custom_domain": true }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "kapture-shares" }],
  "kv_namespaces": [{ "binding": "QUOTAS", "id": "7b8c352113924566884294c22a72a659" }],
  "durable_objects": {
    "bindings": [{ "name": "QUOTA_COUNTERS", "class_name": "QuotaCounter" }]
  },
  "migrations": [{ "tag": "v1-quota-counter", "new_sqlite_classes": ["QuotaCounter"] }],
  "vars": {
    // the owner allowed to delete anyone's share
    "ADMIN_OWNER": "darrin",
    // where /download and /appcast.xml redirect; point this at your own releases
    "RELEASES_BASE": "https://github.com/darrinm/kapture/releases",
    // Cloudflare Access guards /admin. The Worker verifies the JWT itself rather than trusting
    // the header: Access stops anonymous requests at the edge, and this stops anything that
    // reaches the Worker another way. Neither value is a secret.
    "ACCESS_TEAM_DOMAIN": "darrinm.cloudflareaccess.com",
    "ACCESS_AUD": "27a57c8c07cc023544c97caa0eba8480d159befb9ea9c9638eddacd9777372b7",
    // the Access policy already allows only this address; this is the second lock
    "ADMIN_EMAIL": "darrin@massena.com"
  }
  // TOKENS is a secret: wrangler secret put TOKENS
  // (JSON map of owner → sha256 hex of that owner's bearer token)
}
